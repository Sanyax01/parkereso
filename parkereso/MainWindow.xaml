<Window x:Class="parkereso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:parkereso"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="White"/>
                <GradientStop Color="#FF33D2C0" Offset="1"/>
                <GradientStop Color="#FF5EF5E4" Offset="0.83"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="lbox_meret" Margin="0,0,0,280" FontSize="18" BorderThickness="1,10,1,10">
            <ListBox.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterX="0.5" CenterY="0.5"/>
                            <RotateTransform CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform X="2"/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFE600F3"/>
                    <GradientStop Color="#FF2C10BB" Offset="1"/>
                    <GradientStop Color="#FF3A0EBF" Offset="0.923"/>
                    <GradientStop Color="#FFBF0EB0" Offset="0.952"/>
                    <GradientStop Color="#FF3D0DC0" Offset="0.048"/>
                </LinearGradientBrush>
            </ListBox.BorderBrush>
            <ListBox.Background>
                <SolidColorBrush Color="#FF290461" Opacity="0.4"/>
            </ListBox.Background>
        </ListBox>
        <ListBox x:Name="lbox_tema" Margin="0,159,0,150" FontSize="14" Padding="0,10,0,10" BorderThickness="1,10,1,16">
            <ListBox.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFAD3AC8" Offset="0.015"/>
                    <GradientStop Color="#FF3A29B1" Offset="0.052"/>
                    <GradientStop Color="#FFB12999" Offset="0.967"/>
                    <GradientStop Color="#FFB12999" Offset="0.978"/>
                    <GradientStop Color="#FF4629B1" Offset="0.897"/>
                </LinearGradientBrush>
            </ListBox.BorderBrush>
            <ListBox.Background>
                <SolidColorBrush Color="#FF4629B1" Opacity="0.4"/>
            </ListBox.Background>
        </ListBox>
        <Grid x:Name="parkeresoGrid" Grid.Column="1"/>
        <Button x:Name="btn_clickk" Content="start" HorizontalAlignment="Left" Margin="20,323,0,0" VerticalAlignment="Top" Height="73" Width="143" Click="btn_click" FontSize="40" FontFamily="Stencil" BorderThickness="10,0,10,0">
            <Button.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" SpreadMethod="Pad" MappingMode="RelativeToBoundingBox">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FFB700FF" Offset="1"/>
                </LinearGradientBrush>
            </Button.BorderBrush>
            <Button.Background>
                <SolidColorBrush Color="#FFDDDDDD" Opacity="0"/>
            </Button.Background>
        </Button>
        <TextBlock x:Name="prob_box" HorizontalAlignment="Left" Margin="23,284,0,0" TextWrapping="Wrap" Text="" TextAlignment="Center" VerticalAlignment="Top" Height="34" Width="143" FontSize="16" FontWeight="Bold"/>
    </Grid>
</Window>
